APP_ENV=dev
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8030
VMS_TIMEZONE=Asia/Jakarta

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vms?schema=public

# Use random values locally. Never enable the bypass in production.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
BYPASS_LOGIN=replace-with-a-local-development-password
SECRET_KEY=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_KEY=replace-with-a-one-time-bootstrap-secret

# Optional account seed overrides. Defaults are local VMS demo accounts.
# SEED_ADMIN_USERNAME=admin.vms
# SEED_ADMIN_FULL_NAME=VMS Administrator
# SEED_ADMIN_EMAIL=admin@vms.test
# SEED_ADMIN_PASSWORD=
# SEED_PIC_USERNAME=pic.telematika
# SEED_PIC_FULL_NAME=PIC Telematika
# SEED_PIC_EMAIL=pic.telematika@vms.test
# SEED_PIC_PASSWORD=
# SEED_AUDITOR_USERNAME=auditor.vms
# SEED_AUDITOR_FULL_NAME=VMS Auditor
# SEED_AUDITOR_EMAIL=auditor@vms.test
# SEED_AUDITOR_PASSWORD=

# Optional pilot device seed and Tuya cloud credentials.
TUYA_DEVICE_ID=
TUYA_PIN_LENGTH=7
TUYA_API_ENDPOINT=https://openapi-sg.iotbing.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_INGESTION_KEY=replace-with-a-long-random-secret
TUYA_BATTERY_DP_CODES=battery_percentage,battery,battery_state

# Internal adapter expected to deliver EMAIL and WHATSAPP messages.
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
